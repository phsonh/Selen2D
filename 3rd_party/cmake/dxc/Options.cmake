include("${CMAKE_CURRENT_LIST_DIR}/../../dxc/source/cmake/caches/PredefinedParams.cmake")
set_property(GLOBAL APPEND PROPERTY JOB_POOLS engine_dxc_compile=4 engine_dxc_link=1)
set(CMAKE_JOB_POOL_COMPILE engine_dxc_compile CACHE STRING "" FORCE)
set(CMAKE_JOB_POOL_LINK engine_dxc_link CACHE STRING "" FORCE)
set(DXC_DISABLE_ALLOCATOR_OVERRIDES ON CACHE BOOL "" FORCE)
set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
set(ENABLE_SPIRV_CODEGEN OFF CACHE BOOL "" FORCE)
set(ENABLE_METAL_CODEGEN OFF CACHE BOOL "" FORCE)
set(HLSL_BUILD_DXILCONV OFF CACHE BOOL "" FORCE)
set(HLSL_INCLUDE_TESTS OFF CACHE BOOL "" FORCE)
set(LLVM_INCLUDE_TESTS OFF CACHE BOOL "" FORCE)
set(SPIRV_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(LLVM_ENABLE_ZLIB OFF CACHE BOOL "" FORCE)
set(LLVM_USE_CRT_RELEASE MT CACHE STRING "" FORCE)
set(LLVM_USE_CRT_RELWITHDEBINFO MT CACHE STRING "" FORCE)
set(LLVM_USE_CRT_MINSIZEREL MT CACHE STRING "" FORCE)
set(LLVM_USE_CRT_DEBUG MTd CACHE STRING "" FORCE)
# Match the normal MSVC Debug ABI of the host application.
set(HLSL_ENABLE_DEBUG_ITERATORS ON CACHE BOOL "" FORCE)
set(HLSL_SUPPORT_QUERY_GIT_COMMIT_INFO OFF CACHE BOOL "" FORCE)
set(HLSL_ENABLE_FIXED_VER ON CACHE BOOL "" FORCE)
set(HLSL_FIXED_VERSION_LOCATION "" CACHE PATH "" FORCE)
set(DXC_CMAKE_BEGINS_INCLUDE "${CMAKE_CURRENT_LIST_DIR}/Begin.cmake" CACHE FILEPATH "" FORCE)
set(DXC_CMAKE_ENDS_INCLUDE "${CMAKE_CURRENT_LIST_DIR}/Integrate.cmake" CACHE FILEPATH "" FORCE)
