if(NOT MSVC OR NOT WIN32 OR NOT ENGINE_DXC_STATIC)
  message(FATAL_ERROR "The static DXC integration requires Windows MSVC x64")
endif()
if(NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
  message(FATAL_ERROR "The static DXC integration requires x64")
endif()
set_property(GLOBAL APPEND PROPERTY JOB_POOLS engine_dxc_compile=4 engine_dxc_link=1)
set(CMAKE_JOB_POOL_COMPILE engine_dxc_compile)
set(CMAKE_JOB_POOL_LINK engine_dxc_link)

# Compile the installed ATL base-module implementation with this build's
# compiler and CRT. No precompiled ATL library from another toolset is mixed in.
set(atl_base "${ENGINE_DXC_ATL_INCLUDE_DIR}/../src/atl/atls/atlbase.cpp")
if(NOT EXISTS "${atl_base}")
  message(FATAL_ERROR "The Visual Studio ATL source component is required: ${atl_base}")
endif()
target_sources(LLVMMSSupport PRIVATE "${atl_base}")
set_source_files_properties("${atl_base}" TARGET_DIRECTORY LLVMMSSupport
  PROPERTIES COMPILE_DEFINITIONS "_ATL_NO_COMMODULE")

# Traverse the actual upstream dependency graph, never a glob of unrelated or
# stale build artifacts. System libraries stay as normal Windows link inputs.
function(engine_dxc_collect target)
  get_property(visited GLOBAL PROPERTY ENGINE_DXC_VISITED)
  if(target IN_LIST visited)
    return()
  endif()
  set_property(GLOBAL APPEND PROPERTY ENGINE_DXC_VISITED "${target}")
  get_target_property(kind "${target}" TYPE)
  if(kind STREQUAL "STATIC_LIBRARY")
    set_property(GLOBAL APPEND PROPERTY ENGINE_DXC_ARCHIVES "$<TARGET_FILE:${target}>")
    set_property(GLOBAL APPEND PROPERTY ENGINE_DXC_ARCHIVE_TARGETS "${target}")
  elseif(NOT kind STREQUAL "INTERFACE_LIBRARY")
    message(FATAL_ERROR "Non-static DXC dependency: ${target} (${kind})")
  endif()
  foreach(property IN ITEMS LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
    get_target_property(dependencies "${target}" "${property}")
    if(NOT dependencies)
      continue()
    endif()
    foreach(dependency IN LISTS dependencies)
      string(REGEX REPLACE "^\\$<LINK_ONLY:([^>]+)>$" "\\1" dependency "${dependency}")
      if(TARGET "${dependency}")
        engine_dxc_collect("${dependency}")
      elseif(IS_ABSOLUTE "${dependency}" AND dependency MATCHES "\\.lib$")
        set_property(GLOBAL APPEND PROPERTY ENGINE_DXC_ARCHIVES "${dependency}")
      elseif(dependency MATCHES "\\$<")
        message(FATAL_ERROR "Unresolved DXC link expression: ${dependency}")
      elseif(NOT dependency STREQUAL "")
        set_property(GLOBAL APPEND PROPERTY ENGINE_DXC_SYSTEM_LIBRARIES "${dependency}")
      endif()
    endforeach()
  endforeach()
endfunction()
engine_dxc_collect(dxcompiler)
get_property(archives GLOBAL PROPERTY ENGINE_DXC_ARCHIVES)
get_property(archive_targets GLOBAL PROPERTY ENGINE_DXC_ARCHIVE_TARGETS)
get_property(system_libraries GLOBAL PROPERTY ENGINE_DXC_SYSTEM_LIBRARIES)
list(REMOVE_DUPLICATES archives)
list(REMOVE_DUPLICATES archive_targets)
list(REMOVE_DUPLICATES system_libraries)
set(bundle_dir "${CMAKE_BINARY_DIR}/static")
file(MAKE_DIRECTORY "${bundle_dir}")
set(bundle "${bundle_dir}/dxc-static.lib")
set(response "${bundle_dir}/archives.rsp")
set(response_contents "")
foreach(archive IN LISTS archives)
  string(APPEND response_contents "\"${archive}\"\n")
endforeach()
file(GENERATE OUTPUT "${response}" CONTENT "${response_contents}")
file(WRITE "${bundle_dir}/system-libraries.txt" "${system_libraries}\n")
add_custom_command(OUTPUT "${bundle}"
  COMMAND "${CMAKE_AR}" /NOLOGO "/OUT:${bundle}" "@${response}"
  DEPENDS ${archive_targets} ${archives} "${response}"
  VERBATIM COMMENT "Combining the complete DXC static implementation")
add_custom_target(engine_dxc_bundle DEPENDS "${bundle}")

option(ENGINE_DXC_BUILD_PROBE "Build the standalone static runtime compiler probe" OFF)
if(ENGINE_DXC_BUILD_PROBE)
  add_executable(engine_dxc_probe "${CMAKE_CURRENT_LIST_DIR}/Probe.cpp")
  target_include_directories(engine_dxc_probe PRIVATE "${CMAKE_CURRENT_LIST_DIR}" "${LLVM_MAIN_INCLUDE_DIR}")
  target_compile_definitions(engine_dxc_probe PRIVATE DXC_API_IMPORT= NOMINMAX WIN32_LEAN_AND_MEAN)
  target_compile_options(engine_dxc_probe PRIVATE /EHsc)
  target_link_libraries(engine_dxc_probe PRIVATE "${bundle}" ${system_libraries}
    ole32 oleaut32 advapi32 uuid user32 shell32 shlwapi psapi)
  set_property(TARGET engine_dxc_probe PROPERTY MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")
  add_dependencies(engine_dxc_probe engine_dxc_bundle)
endif()
