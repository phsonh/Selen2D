#pragma once
#include "engine/LaunchConfig.h"
#include <array>

// Public development configuration contains no secret. Source and deployment
// layout may be changed by selecting a different header at CMake configure time.
namespace engine::launch_config {
inline constexpr std::array<launch::Mount, 0> mounts{};
inline constexpr std::array directories{
    launch::Directory{launch::Base::Deployment, "example", "example"},
    launch::Directory{launch::Base::Deployment, "output", "output"},
};
inline constexpr launch::Config value{mounts, directories, "example/main.lua", std::nullopt};
}
