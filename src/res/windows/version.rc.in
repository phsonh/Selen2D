#include <windows.h>
1 VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "@ENGINE_DEVELOPER@\0"
   VALUE "Author", "@ENGINE_DEVELOPER@\0"
   VALUE "FileDescription", "@ENGINE_PRODUCT_NAME@\0"
   VALUE "FileVersion", "@ENGINE_FILE_VERSION@\0"
   VALUE "InternalName", "@ENGINE_PRODUCT_NAME@\0"
   VALUE "OriginalFilename", "@ENGINE_EXECUTABLE@\0"
   VALUE "ProductName", "@ENGINE_PRODUCT_NAME@\0"
   VALUE "ProductVersion", "@PROJECT_VERSION@\0"
   VALUE "LegalCopyright", "@ENGINE_COPYRIGHT@\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
