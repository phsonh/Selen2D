cmake_minimum_required(VERSION 3.25)

function(engine_json_quote value output)
    string(REPLACE "\\" "\\\\" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    string(REPLACE "\r" "\\r" value "${value}")
    string(REPLACE "\n" "\\n" value "${value}")
    string(REPLACE "\t" "\\t" value "${value}")
    set(${output} "\"${value}\"" PARENT_SCOPE)
endfunction()

# Inspect the supplied source-built artifact. Never search an SDK or PATH for
# a replacement DLL, and never load the inspected DLL into this process.
function(engine_verify_dxc_runtime runtime_file dumpbin report_directory configuration)
    foreach(input IN ITEMS "${runtime_file}" "${dumpbin}")
        if(NOT IS_ABSOLUTE "${input}" OR NOT EXISTS "${input}" OR
                IS_DIRECTORY "${input}" OR IS_SYMLINK "${input}")
            message(FATAL_ERROR "DXC verification requires an existing absolute ordinary file: ${input}")
        endif()
    endforeach()
    if(NOT IS_ABSOLUTE "${report_directory}" OR NOT configuration MATCHES "^(Debug|Release)$")
        message(FATAL_ERROR "DXC verification requires an absolute report directory and Debug/Release configuration")
    endif()
    get_filename_component(runtime_name "${runtime_file}" NAME)
    if(NOT runtime_name STREQUAL "dxcompiler.dll")
        message(FATAL_ERROR "The only approved DXC runtime artifact is dxcompiler.dll")
    endif()
    file(SHA256 "${runtime_file}" before_hash)
    foreach(kind IN ITEMS HEADERS EXPORTS DEPENDENTS IMPORTS)
        execute_process(COMMAND "${dumpbin}" /NOLOGO "/${kind}" "${runtime_file}"
            RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Cannot inspect DXC ${kind}: ${error}")
        endif()
        string(TOLOWER "${kind}" key)
        set(${key}_output "${output}")
    endforeach()
    if(NOT headers_output MATCHES "8664 machine \\(x64\\)" OR
            NOT headers_output MATCHES "[\r\n][ \t]+DLL[\r\n]")
        message(FATAL_ERROR "DXC runtime is not an x64 PE DLL: ${runtime_file}")
    endif()
    # Match the export-name column, not a symbol/PDB annotation after '='.
    if(NOT exports_output MATCHES "[\r\n][ \t]+[0-9]+[ \t]+[0-9A-Fa-f]+[ \t]+[0-9A-Fa-f]+[ \t]+DxcCreateInstance([ \t\r\n]|$)")
        message(FATAL_ERROR "DXC runtime does not export DxcCreateInstance: ${runtime_file}")
    endif()
    string(REPLACE "\r" "" dependent_lines "${dependents_output}")
    string(REPLACE "\n" ";" dependent_lines "${dependent_lines}")
    set(dependencies)
    set(approved_dependencies kernel32.dll ole32.dll oleaut32.dll advapi32.dll)
    # The verified /MTd ATL base-module cleanup imports UnregisterClassA.
    # Release retains its four-library allowlist; no system DLL is deployed.
    if(configuration STREQUAL "Debug")
        list(APPEND approved_dependencies user32.dll)
    endif()
    foreach(line IN LISTS dependent_lines)
        if(line MATCHES "^[ \t]+([A-Za-z0-9_.-]+\\.[dD][lL][lL])[ \t]*$")
            set(dependency "${CMAKE_MATCH_1}")
            string(TOLOWER "${dependency}" lower_dependency)
            if(NOT lower_dependency IN_LIST approved_dependencies)
                message(FATAL_ERROR "Unapproved DXC runtime dependency: ${dependency}; do not add or collect another runtime DLL")
            endif()
            list(APPEND dependencies "${lower_dependency}")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES dependencies)
    list(SORT dependencies)
    if(NOT dependencies)
        message(FATAL_ERROR "No DXC PE imports were reported; dependency inspection did not succeed")
    endif()

    set(powershell "$ENV{SystemRoot}/System32/WindowsPowerShell/v1.0/powershell.exe")
    if(NOT EXISTS "${powershell}")
        message(FATAL_ERROR "Windows PowerShell is required to inspect DXC version resources")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "ENGINE_DXC_VERIFY_PATH=${runtime_file}"
        "${powershell}" -NoLogo -NoProfile -NonInteractive -Command
        "$v=[Diagnostics.FileVersionInfo]::GetVersionInfo($env:ENGINE_DXC_VERIFY_PATH); [Console]::Out.WriteLine($v.FileVersion); [Console]::Out.WriteLine($v.ProductVersion)"
        RESULT_VARIABLE version_result OUTPUT_VARIABLE version_output ERROR_VARIABLE version_error)
    if(NOT version_result EQUAL 0)
        message(FATAL_ERROR "Cannot inspect DXC version resources: ${version_error}")
    endif()
    string(REPLACE "\r" "" version_output "${version_output}")
    string(STRIP "${version_output}" version_output)
    string(REPLACE "\n" ";" versions "${version_output}")
    list(LENGTH versions version_count)
    if(NOT version_count EQUAL 2)
        message(FATAL_ERROR "DXC runtime must have file and product version resources")
    endif()
    list(GET versions 0 file_version)
    list(GET versions 1 product_version)
    if(NOT file_version STREQUAL "1.9.2609.0" OR NOT product_version STREQUAL "1.9.2609.0")
        message(FATAL_ERROR "DXC runtime version does not match pinned v1.9.2609: ${file_version} / ${product_version}")
    endif()
    file(SHA256 "${runtime_file}" runtime_hash)
    if(NOT runtime_hash STREQUAL before_hash)
        message(FATAL_ERROR "DXC runtime changed while being inspected; retry after its build finishes")
    endif()
    file(SIZE "${runtime_file}" runtime_size)
    set(report "{}")
    foreach(pair IN ITEMS "path;${runtime_file}" "configuration;${configuration}"
            "machine;x64" "requiredExport;DxcCreateInstance" "fileVersion;${file_version}"
            "productVersion;${product_version}" "sha256;${runtime_hash}"
            "sourceTag;v1.9.2609" "sourceCommit;01b62ad47db7dee3dd33f90e7339cf9e860b3f93")
        list(GET pair 0 key)
        list(GET pair 1 value)
        engine_json_quote("${value}" value_json)
        string(JSON report SET "${report}" "${key}" "${value_json}")
    endforeach()
    string(JSON report SET "${report}" bytes "${runtime_size}")
    set(dependency_json "[]")
    foreach(dependency IN LISTS dependencies)
        string(JSON length LENGTH "${dependency_json}")
        engine_json_quote("${dependency}" value_json)
        string(JSON dependency_json SET "${dependency_json}" ${length} "${value_json}")
    endforeach()
    string(JSON report SET "${report}" dependencies "${dependency_json}")
    file(MAKE_DIRECTORY "${report_directory}")
    foreach(kind IN ITEMS headers exports dependents imports)
        file(WRITE "${report_directory}/dxcompiler-${kind}.txt" "${${kind}_output}")
    endforeach()
    file(WRITE "${report_directory}/dxcompiler.json" "${report}\n")
    set(ENGINE_DXC_RUNTIME_SHA256 "${runtime_hash}" PARENT_SCOPE)
    set(ENGINE_DXC_RUNTIME_FILE_VERSION "${file_version}" PARENT_SCOPE)
    set(ENGINE_DXC_RUNTIME_PRODUCT_VERSION "${product_version}" PARENT_SCOPE)
    set(ENGINE_DXC_RUNTIME_DEPENDENCIES "${dependencies}" PARENT_SCOPE)
endfunction()

if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
    foreach(argument IN ITEMS DXC_RUNTIME_FILE DUMPBIN REPORT_DIRECTORY CONFIGURATION)
        if(NOT DEFINED ${argument} OR "${${argument}}" STREQUAL "")
            message(FATAL_ERROR "DXC verification requires ${argument}")
        endif()
    endforeach()
    engine_verify_dxc_runtime("${DXC_RUNTIME_FILE}" "${DUMPBIN}" "${REPORT_DIRECTORY}" "${CONFIGURATION}")
endif()
