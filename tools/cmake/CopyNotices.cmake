cmake_minimum_required(VERSION 3.25)

# Resolve the closest existing ancestor, then append the still-missing suffix.
# This checks junctions without REAL_PATH warnings for new generated files.
function(engine_require_generated_path candidate expected)
    if(NOT IS_ABSOLUTE "${candidate}")
        message(FATAL_ERROR "Expected an absolute generated path: ${candidate}")
    endif()
    set(ancestor "${candidate}")
    set(suffix "")
    while(NOT EXISTS "${ancestor}" AND NOT IS_SYMLINK "${ancestor}")
        get_filename_component(leaf "${ancestor}" NAME)
        get_filename_component(parent "${ancestor}" DIRECTORY)
        if(parent STREQUAL ancestor)
            message(FATAL_ERROR "Cannot resolve generated path: ${candidate}")
        endif()
        set(suffix "/${leaf}${suffix}")
        set(ancestor "${parent}")
    endwhile()
    if(IS_SYMLINK "${ancestor}")
        message(FATAL_ERROR "Generated path must not traverse a symbolic link: ${candidate}")
    endif()
    file(REAL_PATH "${ancestor}" actual)
    set(actual "${actual}${suffix}")
    cmake_path(NORMAL_PATH actual)
    string(TOLOWER "${actual}" actual)
    string(TOLOWER "${expected}" expected)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Generated path escapes its expected location: ${candidate}")
    endif()
endfunction()

# Called both after linking and by release staging. Return an explicit list so
# stale files in a reused bin/licenses directory can never enter a new package.
function(engine_copy_notices source_root destination)
    file(REAL_PATH "${source_root}" source_root)
    engine_require_generated_path("${source_root}/build" "${source_root}/build")
    set(state_root "${source_root}/build/release-work")
    engine_require_generated_path("${state_root}" "${state_root}")
    file(MAKE_DIRECTORY "${state_root}" "${destination}/licenses/project")
    string(SHA256 destination_key "${destination}")
    file(LOCK "${state_root}/notices-${destination_key}.lock" GUARD FUNCTION TIMEOUT 60)

    foreach(required IN ITEMS "${source_root}/LICENSE" "${source_root}/tools/info/THIRD_PARTY_NOTICES.txt"
            "${source_root}/3rd_party/dxc/source/LICENSE.TXT"
            "${source_root}/3rd_party/dxc/source/ThirdPartyNotices.txt")
        if(NOT EXISTS "${required}" OR IS_DIRECTORY "${required}")
            message(FATAL_ERROR "Required source license is missing: ${required}")
        endif()
    endforeach()
    file(COPY_FILE "${source_root}/LICENSE" "${destination}/licenses/project/LICENSE" ONLY_IF_DIFFERENT)
    file(COPY_FILE "${source_root}/tools/info/THIRD_PARTY_NOTICES.txt"
        "${destination}/licenses/project/THIRD_PARTY_NOTICES.txt" ONLY_IF_DIFFERENT)

    file(GLOB_RECURSE candidates LIST_DIRECTORIES FALSE "${source_root}/3rd_party/*")
    set(notice_files)
    foreach(source IN LISTS candidates)
        file(RELATIVE_PATH relative "${source_root}/3rd_party" "${source}")
        get_filename_component(name "${source}" NAME)
        # The old dxc/ root describes SDK DLL redistribution. The static build
        # uses the pinned source's licenses, including its nested components.
        if(relative MATCHES "^dxc/source/(.+)$")
            set(relative "dxc/${CMAKE_MATCH_1}")
        elseif(relative MATCHES "^dxc/")
            continue()
        endif()
        if(name MATCHES "^([Ll][Ii][Cc][Ee][Nn][SsCc][Ee].*|COPYING.*|COPYRIGHT.*|NOTICE.*|ThirdPartyNotices.*|FTL\\.TXT|GPLv2\\.TXT|OFL.*|UNLICENSE.*)$")
            get_filename_component(parent "${relative}" DIRECTORY)
            file(MAKE_DIRECTORY "${destination}/licenses/${parent}")
            file(COPY_FILE "${source}" "${destination}/licenses/${relative}" ONLY_IF_DIFFERENT)
            list(APPEND notice_files "${relative}")
        endif()
    endforeach()
    foreach(relative IN ITEMS README.md SDL_LOCAL_PATCHES.md LuaJIT/HOST_PATCHES.md stb_image/README.md
            dxc/STATIC-INTEGRATION.md dxc/patches/static-embedding.patch)
        get_filename_component(parent "${relative}" DIRECTORY)
        file(MAKE_DIRECTORY "${destination}/licenses/${parent}")
        file(COPY_FILE "${source_root}/3rd_party/${relative}"
            "${destination}/licenses/${relative}" ONLY_IF_DIFFERENT)
        list(APPEND notice_files "${relative}")
    endforeach()
    list(SORT notice_files)
    set(ENGINE_NOTICE_FILES "${notice_files}" PARENT_SCOPE)
endfunction()

if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
    if(NOT SOURCE_ROOT OR NOT DESTINATION)
        message(FATAL_ERROR "CopyNotices requires SOURCE_ROOT and DESTINATION")
    endif()
    engine_copy_notices("${SOURCE_ROOT}" "${DESTINATION}")
endif()
