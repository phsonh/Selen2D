include_guard(GLOBAL)

function(engine_add_runtime_dxc)
    if(TARGET DependencyDXC)
        return()
    endif()
    if(NOT WIN32 OR NOT MSVC OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
        message(FATAL_ERROR "Runtime DXC currently supports Windows MSVC x64 only")
    endif()
    if(NOT CMAKE_GENERATOR STREQUAL "Ninja" OR NOT CMAKE_BUILD_TYPE)
        message(FATAL_ERROR "Runtime DXC requires a single-configuration Ninja build")
    endif()
    get_filename_component(project_root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../.." ABSOLUTE)
    set(source "${project_root}/3rd_party/dxc/source")
    set(integration "${project_root}/3rd_party/cmake/dxc")
    if(NOT EXISTS "${source}/LICENSE.TXT" OR NOT EXISTS "${source}/tools/clang/tools/dxcompiler/DXCompiler.cpp")
        message(FATAL_ERROR "Pinned DXC source is missing; builds never download runtime dependencies")
    endif()
    find_package(Python3 3.10 REQUIRED COMPONENTS Interpreter)
    file(TO_CMAKE_PATH "${Python3_EXECUTABLE}" dxc_python)
    set(ENGINE_DXC_RUNTIME_BINARY_DIR "${CMAKE_BINARY_DIR}/dependencies/dxc-runtime" CACHE PATH
        "Isolated runtime DXC build directory; never share between toolchains or configurations")
    get_filename_component(ENGINE_DXC_RUNTIME_BINARY_DIR "${ENGINE_DXC_RUNTIME_BINARY_DIR}" ABSOLUTE BASE_DIR "${CMAKE_BINARY_DIR}")
    file(TO_CMAKE_PATH "${ENGINE_DXC_RUNTIME_BINARY_DIR}" ENGINE_DXC_RUNTIME_BINARY_DIR)
    set(ENGINE_DXC_JOBS 4 CACHE STRING "DXC build parallelism (1-4; bounded for LLVM memory use)")
    if(NOT ENGINE_DXC_JOBS MATCHES "^[1-4]$")
        message(FATAL_ERROR "ENGINE_DXC_JOBS must be an integer from 1 to 4")
    endif()
    set(runtime "${ENGINE_DXC_RUNTIME_BINARY_DIR}/bin/dxcompiler.dll")
    set(stamp "${ENGINE_DXC_RUNTIME_BINARY_DIR}/runtime-build.stamp")
    # Track dependency inputs only: engine edits never run the nested build.
    file(GLOB_RECURSE dxc_inputs CONFIGURE_DEPENDS LIST_DIRECTORIES FALSE
        "${source}/*" "${integration}/*")
    list(FILTER dxc_inputs EXCLUDE REGEX "/__pycache__/|\\.pyc$")
    set(source_manifest "${CMAKE_CURRENT_BINARY_DIR}/DxcRuntimeSources.txt")
    file(GENERATE OUTPUT "${source_manifest}" CONTENT "${dxc_inputs}\n")
    set(toolchain_inputs "${CMAKE_C_COMPILER}" "${CMAKE_CXX_COMPILER}" "${CMAKE_AR}" "${CMAKE_LINKER}")
    get_filename_component(compiler_dir "${CMAKE_CXX_COMPILER}" DIRECTORY)
    file(GLOB compiler_parts CONFIGURE_DEPENDS "${compiler_dir}/*.dll")
    list(APPEND toolchain_inputs ${compiler_parts})
    if(CMAKE_TOOLCHAIN_FILE)
        list(APPEND toolchain_inputs "${CMAKE_TOOLCHAIN_FILE}")
    endif()
    find_path(ENGINE_DXC_ATL_INCLUDE_DIR atlbase.h HINTS "$ENV{VCToolsInstallDir}/atlmfc/include")
    if(NOT ENGINE_DXC_ATL_INCLUDE_DIR AND DEFINED ENV{VCINSTALLDIR})
        file(GLOB atl_candidates "$ENV{VCINSTALLDIR}/Tools/MSVC/*/atlmfc/include")
        list(SORT atl_candidates COMPARE NATURAL ORDER DESCENDING)
        find_path(ENGINE_DXC_ATL_INCLUDE_DIR atlbase.h HINTS ${atl_candidates})
    endif()
    if(NOT ENGINE_DXC_ATL_INCLUDE_DIR)
        message(FATAL_ERROR "DXC requires the Visual Studio C++ ATL component")
    endif()
    set(atl_source "${ENGINE_DXC_ATL_INCLUDE_DIR}/../src/atl/atls/atlbase.cpp")
    list(APPEND dxc_inputs "${atl_source}" "${ENGINE_DXC_ATL_INCLUDE_DIR}/atlbase.h")
    list(REMOVE_DUPLICATES toolchain_inputs)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${toolchain_inputs})
    set(context "${source}|${CMAKE_BUILD_TYPE}|${CMAKE_C_COMPILER_ID}|${CMAKE_C_COMPILER_VERSION}|${CMAKE_CXX_COMPILER_ID}|${CMAKE_CXX_COMPILER_VERSION}|${CMAKE_SYSTEM_VERSION}|${CMAKE_MSVC_RUNTIME_LIBRARY}|${ENGINE_DXC_ATL_INCLUDE_DIR}")
    foreach(input IN LISTS toolchain_inputs)
        if(EXISTS "${input}")
            file(SIZE "${input}" input_size)
            file(TIMESTAMP "${input}" input_time "%Y-%m-%dT%H:%M:%S.%fZ" UTC)
            string(APPEND context "|${input}:${input_size}:${input_time}")
        endif()
    endforeach()
    string(SHA256 context "${context}")
    set(build_script "${CMAKE_CURRENT_BINARY_DIR}/DxcRuntimeBuild.cmake")
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/DxcRuntimeBuild.cmake.in" "${build_script}" @ONLY)
    add_custom_command(OUTPUT "${runtime}" "${stamp}"
        COMMAND "${CMAKE_COMMAND}" -P "${build_script}"
        DEPENDS "${build_script}" "${source_manifest}" "${CMAKE_CURRENT_FUNCTION_LIST_FILE}"
            ${dxc_inputs} ${toolchain_inputs}
        VERBATIM USES_TERMINAL COMMENT "Building pinned runtime DXC (${CMAKE_BUILD_TYPE})")
    add_custom_target(engine_dxc_build DEPENDS "${runtime}" "${stamp}")
    # Headers/build ordering only; no import library reaches the host link.
    add_library(DependencyDXC INTERFACE)
    target_include_directories(DependencyDXC SYSTEM INTERFACE "${source}/include")
    set_property(TARGET DependencyDXC PROPERTY ENGINE_DXC_RUNTIME_FILE "${runtime}")
    add_dependencies(DependencyDXC engine_dxc_build)
    message(STATUS "Runtime DXC (${CMAKE_BUILD_TYPE}): ${runtime}")
endfunction()
