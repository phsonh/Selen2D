# Generated build-only command. The outer Ninja graph owns input tracking.
execute_process(COMMAND "@dxc_python@" -B "@helper@" prepare
    "@bundle@" "@state@" "@health@" "@context@"
    OUTPUT_VARIABLE action OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
set(fresh)
if(action STREQUAL "reset" AND EXISTS "@ENGINE_DXC_BINARY_DIR@/build.ninja")
    message(STATUS "Static DXC toolchain/configuration changed; cleaning incompatible objects")
    execute_process(COMMAND "@CMAKE_COMMAND@" --build "@ENGINE_DXC_BINARY_DIR@" --target clean
        COMMAND_ERROR_IS_FATAL ANY)
    set(fresh --fresh)
endif()
execute_process(COMMAND "@CMAKE_COMMAND@" -E env PYTHONDONTWRITEBYTECODE=1 "@CMAKE_COMMAND@" ${fresh}
    -S "@source@" -B "@ENGINE_DXC_BINARY_DIR@" -G Ninja -C "@integration@/Options.cmake"
    "-DCMAKE_BUILD_TYPE=@CMAKE_BUILD_TYPE@"
    "-DCMAKE_C_COMPILER=@CMAKE_C_COMPILER@"
    "-DCMAKE_CXX_COMPILER=@CMAKE_CXX_COMPILER@"
    "-DCMAKE_MAKE_PROGRAM=@CMAKE_MAKE_PROGRAM@"
    "-DPython3_EXECUTABLE=@dxc_python@"
    -DENGINE_DXC_BUILD_PROBE=OFF
    COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "@CMAKE_COMMAND@" -E env PYTHONDONTWRITEBYTECODE=1 "@CMAKE_COMMAND@" --build "@ENGINE_DXC_BINARY_DIR@"
    --target engine_dxc_bundle --parallel @ENGINE_DXC_JOBS@
    COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "@dxc_python@" -B "@helper@" record
    "@bundle@" "@state@" "@stamp@" "@context@"
    COMMAND_ERROR_IS_FATAL ANY)
